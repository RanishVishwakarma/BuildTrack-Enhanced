APP_NAME=BuildTrack API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=buildtrack

JWT_SECRET_KEY=change-this-secret-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Outgoing email (password reset, notifications). Leave empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Local development only: return reset codes in the API response. Never on a shared server.
PASSWORD_RESET_RETURN_TOKEN=false

# --- AI (Anthropic Claude). Leave ANTHROPIC_API_KEY empty to keep AI features off.
# Chat engine: quick (free, no AI model), ollama (free, local model), anthropic (paid Claude).
AI_PROVIDER=quick
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_TIMEOUT_SECONDS=120
# false = no paid AI calls are ever made, even with a key set.
AI_ENABLED=true
ANTHROPIC_API_KEY=
# Only for keys not scoped to a workspace (Console > Workspaces > workspace ID).
ANTHROPIC_WORKSPACE_ID=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_MAX_TOOL_ROUNDS=8
AI_REQUESTS_PER_HOUR=60
AI_TIMEOUT_SECONDS=90

# --- Background monitoring
MONITORING_ENABLED=true
MONITORING_INTERVAL_MINUTES=15
ESCALATION_AFTER_MINUTES=120

# --- Private storage for progress photos (never served publicly)
PRIVATE_UPLOAD_DIR=private_uploads
EVIDENCE_MAX_BYTES=10485760
DOWNLOAD_LINK_SECONDS=300

# --- Automated voice calls (Twilio). Off unless every value below is set.
VOICE_CALLS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public HTTPS address of this backend, used for Twilio callbacks.
PUBLIC_BASE_URL=
VOICE_CALL_HOURS=08:00-20:00
VOICE_CALL_TIMEZONE=Asia/Kolkata
VOICE_MAX_ATTEMPTS=2
